<Application x:Class="WpfNotesSample.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styles="clr-namespace:WpfNotesSample.View.Styles"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--  配色は先頭に置く。テーマの切り替えでこの位置の辞書を差し替える（View/Styles/Window.xaml.cs）。  -->
        <ResourceDictionary Source="View/Styles/Colors.Light.xaml" />
        <ResourceDictionary Source="View/Styles/Theme.xaml" />
        <ResourceDictionary Source="View/Styles/Icons.xaml" />
        <ResourceDictionary Source="View/Styles/Controls.xaml" />
        <ResourceDictionary Source="View/Styles/Roles.xaml" />
        <styles:WindowStyles />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
