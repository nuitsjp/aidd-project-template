<Window x:Class="WpfNotesSample.View.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}"
        Style="{StaticResource DialogWindowStyle}">
  <StackPanel>
    <Control Style="{StaticResource ConfirmIconStyle}" />
    <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitleTextStyle}" />
    <TextBlock x:Name="MessageText" Style="{StaticResource DialogContentTextStyle}" />
    <StackPanel Style="{StaticResource DialogFooterStyle}">
      <Button x:Name="CancelButton"
              Content="キャンセル"
              IsCancel="True"
              Style="{StaticResource TextButtonStyle}" />
      <Button x:Name="OkButton"
              Margin="{StaticResource ItemGap}"
              Click="OnOk"
              Content="OK"
              Style="{StaticResource TextButtonStyle}" />
    </StackPanel>
  </StackPanel>
</Window>
