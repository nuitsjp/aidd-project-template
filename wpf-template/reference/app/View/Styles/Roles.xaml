<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:WpfNotesSample.View">
  <!--  Layout。ページ背景は colorBgLayout とし、内容は白い Card に載せて境界を示す（Ant Design Pro と同じ構成）。  -->
  <Style x:Key="AppContentStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ColorBgLayoutBrush}" />
    <Setter Property="Padding" Value="{StaticResource LayoutPadding}" />
  </Style>
  <Style x:Key="PageBarStyle" TargetType="Grid">
    <Setter Property="Margin" Value="{StaticResource PageBarSpacing}" />
  </Style>
  <Style x:Key="PageActionsStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!--  Typography.Title level 4  -->
  <Style x:Key="PageTitleTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading4}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightHeading4}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!--  Card  -->
  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorderSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineWidth}" />
    <Setter Property="CornerRadius" Value="{StaticResource BorderRadiusLG}" />
    <Setter Property="Padding" Value="{StaticResource CardBodyPadding}" />
  </Style>
  <!--  表を載せる Card。表のヘッダーの角丸が Card の角に重なるよう、内側の余白を置かない。  -->
  <Style x:Key="TableCardStyle"
         BasedOn="{StaticResource CardStyle}"
         TargetType="Border">
    <Style.Resources>
      <!--  表の背景を透明にし、Card の角丸を見せる。  -->
      <Style BasedOn="{StaticResource {x:Type DataGrid}}" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </Style.Resources>
    <Setter Property="Padding" Value="0" />
  </Style>

  <!--
    Button: type="primary"、danger、type="text"、type="link"。操作は文字（必要ならアイコン付き）で示し、
    アイコンのみは PageHeader の戻る操作とウィンドウ操作に限る。
  -->
  <Style x:Key="PrimaryButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Style.Resources>
      <SolidColorBrush x:Key="ButtonShadowBrush" Color="#1A0591FF" />
    </Style.Resources>
    <Setter Property="Background" Value="{StaticResource ColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextLightSolidBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ColorPrimaryHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextLightSolidBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource ColorPrimaryActiveBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextLightSolidBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource ColorBgContainerDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="DangerButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Style.Resources>
      <SolidColorBrush x:Key="ButtonShadowBrush" Color="#0FFF2605" />
    </Style.Resources>
    <Setter Property="BorderBrush" Value="{StaticResource ColorErrorBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ColorErrorBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource ColorErrorHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorErrorHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource ColorErrorActiveBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorErrorActiveBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource ColorBgContainerDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TextButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Style.Resources>
      <SolidColorBrush x:Key="ButtonShadowBrush" Color="Transparent" />
    </Style.Resources>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ColorFillTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource ColorFillBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!--  PageHeader の戻る操作。アイコンは 16。  -->
  <Style x:Key="BackButtonStyle"
         BasedOn="{StaticResource TextButtonStyle}"
         TargetType="Button">
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeLG}" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <!--  表の操作列。size="small" の type="link"。  -->
  <Style x:Key="RowActionButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Style.Resources>
      <SolidColorBrush x:Key="ButtonShadowBrush" Color="Transparent" />
      <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
    </Style.Resources>
    <Setter Property="Height" Value="{StaticResource ControlHeightSM}" />
    <Setter Property="Padding" Value="{StaticResource ButtonPaddingSM}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ColorPrimaryBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorLinkHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorPrimaryActiveBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--  Alert（description なし）  -->
  <Style x:Key="AlertStyle" TargetType="Border">
    <Setter Property="BorderThickness" Value="{StaticResource LineWidth}" />
    <Setter Property="CornerRadius" Value="{StaticResource BorderRadiusLG}" />
    <Setter Property="Padding" Value="{StaticResource AlertPadding}" />
    <Setter Property="Margin" Value="{StaticResource AlertSpacing}" />
  </Style>
  <Style x:Key="ErrorAlertStyle"
         BasedOn="{StaticResource AlertStyle}"
         TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ColorErrorBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorErrorBorderBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ErrorMessage}" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SuccessAlertStyle"
         BasedOn="{StaticResource AlertStyle}"
         TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ColorSuccessBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorSuccessBorderBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusMessage}" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ErrorAlertIconStyle"
         BasedOn="{StaticResource IconStyle}"
         TargetType="Control">
    <Setter Property="v:Icon.Data" Value="{StaticResource IconCloseCircleFilled}" />
    <Setter Property="Foreground" Value="{StaticResource ColorErrorBrush}" />
    <Setter Property="Margin" Value="{StaticResource IconGap}" />
  </Style>
  <Style x:Key="SuccessAlertIconStyle"
         BasedOn="{StaticResource IconStyle}"
         TargetType="Control">
    <Setter Property="v:Icon.Data" Value="{StaticResource IconCheckCircleFilled}" />
    <Setter Property="Foreground" Value="{StaticResource ColorSuccessBrush}" />
    <Setter Property="Margin" Value="{StaticResource IconGap}" />
  </Style>
  <Style x:Key="AlertTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  Tag（warning、filled）  -->
  <Style x:Key="ModeTagStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ColorWarningBgBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{StaticResource LineWidth}" />
    <Setter Property="CornerRadius" Value="{StaticResource BorderRadiusSM}" />
    <Setter Property="Padding" Value="{StaticResource TagPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0,0,0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Mode}" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ModeTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ColorWarningBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightSM}" />
  </Style>

  <!--  Table の空表示（Empty の PRESENTED_IMAGE_SIMPLE）。表の見出し・セル余白・Empty の余白の下に置く。  -->
  <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="8,78,8,0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Notes.Count}" Value="0">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="EmptyImageStyle" TargetType="Control">
    <Setter Property="Height" Value="{StaticResource ControlHeightLG}" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <!--  antd 6.6.5 es/empty/simple.js（MIT License, Copyright (c) 2015-present Ant UED。全文は THIRD-PARTY-NOTICES.txt）  -->
          <Viewbox>
            <Canvas Width="64" Height="41">
              <Canvas Canvas.Top="1">
                <Ellipse Canvas.Top="26"
                         Width="64"
                         Height="14"
                         Fill="{StaticResource EmptyShadowBrush}" />
                <Path Data="M55 12.8 44.9 1.3Q44 0 42.9 0H21.1q-1.2 0-2 1.3L9 12.8V22h46z" Stroke="{StaticResource EmptyBorderBrush}" />
                <Path Data="M41.6 16c0-1.7 1-3 2.2-3H55v18.1c0 2.2-1.3 3.9-3 3.9H12c-1.7 0-3-1.7-3-3.9V13h11.2c1.2 0 2.2 1.3 2.2 3s1 2.9 2.2 2.9h14.8c1.2 0 2.2-1.4 2.2-3"
                      Fill="{StaticResource EmptyContentBrush}"
                      Stroke="{StaticResource EmptyBorderBrush}" />
              </Canvas>
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EmptyStateTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ColorTextTertiaryBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!--  Form（vertical）  -->
  <Style x:Key="FormItemStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="{StaticResource FormItemSpacing}" />
  </Style>
  <Style x:Key="RequiredLabelStyle"
         BasedOn="{StaticResource {x:Type Label}}"
         TargetType="Label">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Label">
          <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal">
            <TextBlock Margin="0,0,4,0"
                       VerticalAlignment="Center"
                       FontFamily="Arial"
                       Foreground="{StaticResource ColorErrorBrush}"
                       LineHeight="{StaticResource FontSize}"
                       Text="*" />
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TextAreaStyle"
         BasedOn="{StaticResource {x:Type TextBox}}"
         TargetType="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <!--  Modal.confirm  -->
  <Style x:Key="ConfirmIconStyle"
         BasedOn="{StaticResource IconStyle}"
         TargetType="Control">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource ColorWarningBrush}" />
    <Setter Property="Margin" Value="0,1,12,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style x:Key="ModalTitleTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeading5}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightHeading5}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="ModalContentTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
  <Style x:Key="ModalFooterStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,12,0,0" />
  </Style>
</ResourceDictionary>
