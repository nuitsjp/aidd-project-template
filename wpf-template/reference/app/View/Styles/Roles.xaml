<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:v="clr-namespace:WpfNotesSample.View">
  <!--  Layout。ページは surface の上に置き、一覧と本文は surface container lowest の色面（角丸 28）に載せる。  -->
  <Style x:Key="AppContentStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Padding" Value="{StaticResource LayoutPadding}" />
  </Style>
  <Style x:Key="PageBarStyle" TargetType="Grid">
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="Margin" Value="{StaticResource PageBarSpacing}" />
  </Style>
  <Style x:Key="PageActionsStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="PageHeadingStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!--  一覧の見出し（headline medium）と件数（label large）。  -->
  <Style x:Key="PageHeadlineTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeadlineMedium}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightHeadlineMedium}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="PageCountTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="12,6,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!--  詳細の見出し（title large）。  -->
  <Style x:Key="PageTitleTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitleLarge}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightTitleLarge}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ListSurfaceStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowestBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ShapeExtraLarge}" />
    <Setter Property="Padding" Value="{StaticResource ListSurfacePadding}" />
  </Style>
  <Style x:Key="PaperStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerLowestBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ShapeExtraLarge}" />
    <Setter Property="Padding" Value="{StaticResource PaperPadding}" />
  </Style>

  <!--
    Button: filled・tonal・text・error の outlined・icon と、一覧の追加に使う extended FAB。
    操作は文字（必要ならアイコン付き）で示し、アイコンのみは戻る操作とタイトルバーの操作に限る。
  -->
  <Style x:Key="FilledButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource DisabledContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DisabledContentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TonalButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource DisabledContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DisabledContentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ErrorOutlinedButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="BorderBrush" Value="{DynamicResource DisabledContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DisabledContentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TextButtonStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Setter Property="Padding" Value="{StaticResource TextButtonPadding}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!--  戻る操作。40 の円で、アイコンは 24。  -->
  <Style x:Key="IconButtonStyle"
         BasedOn="{StaticResource TextButtonStyle}"
         TargetType="Button">
    <Style.Resources>
      <sys:Double x:Key="ButtonIconSize">24</sys:Double>
    </Style.Resources>
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Setter Property="Margin" Value="-8,0,8,0" />
  </Style>
  <!--  Extended FAB。一覧の色面の右下に重ね、elevation 3 の影を落とす。  -->
  <Style x:Key="FabStyle"
         BasedOn="{StaticResource BaseButtonStyle}"
         TargetType="Button">
    <Style.Resources>
      <CornerRadius x:Key="ButtonCornerRadius">16</CornerRadius>
      <sys:Double x:Key="ButtonIconSize">24</sys:Double>
    </Style.Resources>
    <Setter Property="Height" Value="{StaticResource FabHeight}" />
    <Setter Property="Padding" Value="{StaticResource FabPadding}" />
    <Setter Property="Margin" Value="0,0,16,16" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12"
                          Direction="270"
                          Opacity="0.25"
                          ShadowDepth="3" />
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource DisabledContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DisabledContentBrush}" />
        <Setter Property="Effect" Value="{x:Null}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--  Banner。エラーは error container、操作の結果は secondary container の色面で示す。  -->
  <Style x:Key="BannerStyle" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource ShapeMedium}" />
    <Setter Property="Padding" Value="{StaticResource BannerPadding}" />
    <Setter Property="Margin" Value="{StaticResource BannerSpacing}" />
  </Style>
  <Style x:Key="ErrorBannerStyle"
         BasedOn="{StaticResource BannerStyle}"
         TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource ErrorContainerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnErrorContainerBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding ErrorMessage}" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SuccessBannerStyle"
         BasedOn="{StaticResource BannerStyle}"
         TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding StatusMessage}" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
      <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ErrorBannerIconStyle"
         BasedOn="{StaticResource IconStyle}"
         TargetType="Control">
    <Setter Property="v:Icon.Data" Value="{StaticResource IconExclamationCircleFilled}" />
    <Setter Property="Width" Value="{StaticResource IconSizeLarge}" />
    <Setter Property="Height" Value="{StaticResource IconSizeLarge}" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>
  <Style x:Key="SuccessBannerIconStyle"
         BasedOn="{StaticResource ErrorBannerIconStyle}"
         TargetType="Control">
    <Setter Property="v:Icon.Data" Value="{StaticResource IconCheckCircleFilled}" />
  </Style>
  <Style x:Key="BannerTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--  モック表示のタグ（tertiary container）。  -->
  <Style x:Key="ModeTagStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource TertiaryContainerBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource ShapeSmall}" />
    <Setter Property="Padding" Value="{StaticResource TagPadding}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="12,0,0,0" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Mode}" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ModeTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnTertiaryContainerBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>

  <!--  一覧の項目。先頭にタイトルの頭文字の円、続けてタイトル（body large）と更新日時（body medium）の 2 行。  -->
  <v:InitialConverter x:Key="InitialConverter" />
  <Style x:Key="AvatarStyle" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource AvatarSize}" />
    <Setter Property="Height" Value="{StaticResource AvatarSize}" />
    <Setter Property="CornerRadius" Value="{StaticResource ShapeFull}" />
    <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnPrimaryContainerBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource OnPrimaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AvatarTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ListItemTextStyle" TargetType="StackPanel">
    <Setter Property="Margin" Value="16,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ListHeadlineTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightBodyLarge}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="ListSupportingTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!--  一覧の空表示。傾けた角丸の色面にノートの形を置き、見出しと次の操作を示す。  -->
  <Style x:Key="EmptyStateStyle" TargetType="StackPanel">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Visibility" Value="Collapsed" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Notes.Count}" Value="0">
        <Setter Property="Visibility" Value="Visible" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="EmptyIllustrationStyle" TargetType="Border">
    <Setter Property="Width" Value="112" />
    <Setter Property="Height" Value="112" />
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="CornerRadius" Value="36" />
    <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnPrimaryContainerBrush}" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <RotateTransform Angle="-6" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EmptyIconStyle"
         BasedOn="{StaticResource IconStyle}"
         TargetType="Control">
    <Setter Property="v:Icon.Data" Value="{StaticResource IconNote}" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <RotateTransform Angle="6" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EmptyTitleTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitleLarge}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightTitleLarge}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style x:Key="EmptyBodyTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!--  詳細の更新日時（assist chip 相当の色面）と本文（body large、行高 28）。  -->
  <Style x:Key="MetaChipStyle" TargetType="Border">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="{StaticResource ShapeSmall}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
        <Setter Property="Visibility" Value="Collapsed" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="MetaIconStyle"
         BasedOn="{StaticResource IconStyle}"
         TargetType="Control">
    <Setter Property="v:Icon.Data" Value="{StaticResource IconClock}" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>
  <Style x:Key="MetaTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightBodySmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="ReadingTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightReading}" />
  </Style>

  <!--  Filled text field。上側だけ角丸の色面に、ラベルと入力を重ね、下辺の線でフォーカスを示す（1 → 3）。  -->
  <Style x:Key="FilledFieldStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighestBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="CornerRadius" Value="{StaticResource ShapeExtraSmallTop}" />
    <Setter Property="Padding" Value="{StaticResource FieldPadding}" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,3" />
        <Setter Property="Padding" Value="{StaticResource FieldFocusedPadding}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource DisabledContainerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DisabledContentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="FieldLabelStyle"
         BasedOn="{StaticResource {x:Type Label}}"
         TargetType="Label">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!--  必須の入力欄はラベルの後ろに * を付ける。  -->
  <Style x:Key="RequiredFieldLabelStyle"
         BasedOn="{StaticResource FieldLabelStyle}"
         TargetType="Label">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Label">
          <StackPanel Margin="{TemplateBinding Padding}" Orientation="Horizontal">
            <ContentPresenter RecognizesAccessKey="True" />
            <TextBlock Text=" *" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FieldHelpTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Margin" Value="16,4,16,0" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightBodySmall}" />
  </Style>
  <Style x:Key="TextAreaStyle"
         BasedOn="{StaticResource {x:Type TextBox}}"
         TargetType="TextBox">
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>

  <!--  Basic dialog。上から中央揃えのアイコン、見出し（headline small）、本文、右寄せの text ボタンを並べる。  -->
  <Style x:Key="ConfirmIconStyle"
         BasedOn="{StaticResource IconStyle}"
         TargetType="Control">
    <Setter Property="v:Icon.Data" Value="{StaticResource IconExclamationCircleFilled}" />
    <Setter Property="Width" Value="{StaticResource IconSizeLarge}" />
    <Setter Property="Height" Value="{StaticResource IconSizeLarge}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>
  <Style x:Key="DialogTitleTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeHeadlineSmall}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightHeadlineSmall}" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style x:Key="DialogContentTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Margin" Value="0,16,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
  </Style>
  <Style x:Key="DialogFooterStyle" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,24,0,0" />
  </Style>
</ResourceDictionary>
