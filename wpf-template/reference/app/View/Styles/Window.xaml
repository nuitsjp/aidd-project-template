<ResourceDictionary x:Class="WpfNotesSample.View.Styles.WindowStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:WpfNotesSample.View"
                    x:ClassModifier="internal">
  <!--  OS のタイトルバーを使わず、ウィンドウ枠をアプリ側で描く。画面の中身は各 Window の XAML に置く。  -->
  <Style x:Key="CaptionButtonStyle"
         BasedOn="{StaticResource TextButtonStyle}"
         TargetType="Button">
    <Setter Property="Width" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
  </Style>
  <Style x:Key="CloseCaptionButtonStyle"
         BasedOn="{StaticResource CaptionButtonStyle}"
         TargetType="Button">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ColorErrorBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorErrorBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{StaticResource ColorErrorBgActiveBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorErrorActiveBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TitleBarStyle" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource ControlHeightLG}" />
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorSplitBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style x:Key="AppMarkStyle" TargetType="Border">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="CornerRadius" Value="{StaticResource BorderRadiusSM}" />
    <Setter Property="Background" Value="{StaticResource ColorPrimaryBrush}" />
  </Style>
  <Style x:Key="AppMarkTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ColorTextLightSolidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSM}" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeightSM}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="WindowTitleTextStyle"
         BasedOn="{StaticResource {x:Type TextBlock}}"
         TargetType="TextBlock">
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="AppWindowStyle" TargetType="Window">
    <Setter Property="Width" Value="1040" />
    <Setter Property="Height" Value="760" />
    <Setter Property="MinWidth" Value="800" />
    <Setter Property="MinHeight" Value="600" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="WindowChrome.WindowChrome">
      <Setter.Value>
        <WindowChrome CaptionHeight="{StaticResource ControlHeightLG}"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      UseAeroCaptionButtons="False" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border x:Name="Frame" Background="{TemplateBinding Background}">
            <Grid>
              <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource TitleBarStyle}">
                  <DockPanel>
                    <StackPanel Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                Orientation="Horizontal">
                      <Button v:Icon.Data="{StaticResource IconMinus}"
                              AutomationProperties.Name="最小化"
                              Click="OnMinimize"
                              Style="{StaticResource CaptionButtonStyle}"
                              ToolTip="最小化" />
                      <Button x:Name="MaximizeButton"
                              v:Icon.Data="{StaticResource IconBorder}"
                              AutomationProperties.Name="最大化"
                              Click="OnMaximizeRestore"
                              Style="{StaticResource CaptionButtonStyle}"
                              ToolTip="最大化" />
                      <Button v:Icon.Data="{StaticResource IconClose}"
                              AutomationProperties.Name="閉じる"
                              Click="OnClose"
                              Style="{StaticResource CloseCaptionButtonStyle}"
                              ToolTip="閉じる" />
                    </StackPanel>
                    <StackPanel Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                      <Border Style="{StaticResource AppMarkStyle}">
                        <TextBlock Style="{StaticResource AppMarkTextStyle}" Text="N" />
                      </Border>
                      <TextBlock Style="{StaticResource WindowTitleTextStyle}" Text="{TemplateBinding Title}" />
                      <Border Style="{StaticResource ModeTagStyle}">
                        <TextBlock x:Name="ModeText"
                                   Style="{StaticResource ModeTextStyle}"
                                   Text="{Binding Mode}" />
                      </Border>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <AdornerDecorator>
                  <ContentPresenter />
                </AdornerDecorator>
              </DockPanel>
              <!--  Modal の mask。確認ダイアログの表示中だけ DialogService が表示する。  -->
              <Border x:Name="PART_Mask"
                      Background="{StaticResource ColorBgMaskBrush}"
                      Visibility="Collapsed" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="WindowState" Value="Maximized">
              <Setter TargetName="Frame" Property="Padding" Value="{x:Static SystemParameters.WindowResizeBorderThickness}" />
              <Setter TargetName="MaximizeButton" Property="v:Icon.Data" Value="{StaticResource IconBlock}" />
              <Setter TargetName="MaximizeButton" Property="ToolTip" Value="元に戻す" />
              <Setter TargetName="MaximizeButton" Property="AutomationProperties.Name" Value="元に戻す" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Modal.confirm の器。幅 416、角丸と影は Windows 11 の DWM が描く。  -->
  <Style x:Key="DialogWindowStyle" TargetType="Window">
    <Setter Property="Width" Value="416" />
    <Setter Property="SizeToContent" Value="Height" />
    <Setter Property="ResizeMode" Value="NoResize" />
    <Setter Property="ShowInTaskbar" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="WindowChrome.WindowChrome">
      <Setter.Value>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="0,0,0,1"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Window">
          <Border Padding="{StaticResource ModalContentPadding}" Background="{TemplateBinding Background}">
            <AdornerDecorator>
              <ContentPresenter />
            </AdornerDecorator>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
