<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!--
    Material Design 3 のタイプスケール・形状スケール・余白を、WPF のデバイス非依存単位で表す。キー名はスケール名に合わせる。
    色は Colors.Light.xaml と Colors.Dark.xaml に置く。書体は app/Fonts/ に同梱した Roboto と Noto Sans JP（400・500）を使う。
  -->
  <FontFamily x:Key="FontFamilyUi">/Fonts/#Roboto, /Fonts/#Noto Sans JP</FontFamily>
  <sys:Double x:Key="FontSize">14</sys:Double>
  <sys:Double x:Key="LineHeight">20</sys:Double>
  <sys:Double x:Key="FontSizeBodySmall">12</sys:Double>
  <sys:Double x:Key="LineHeightBodySmall">16</sys:Double>
  <sys:Double x:Key="FontSizeBodyLarge">16</sys:Double>
  <sys:Double x:Key="LineHeightBodyLarge">24</sys:Double>
  <sys:Double x:Key="LineHeightReading">28</sys:Double>
  <sys:Double x:Key="FontSizeTitleLarge">22</sys:Double>
  <sys:Double x:Key="LineHeightTitleLarge">28</sys:Double>
  <sys:Double x:Key="FontSizeHeadlineSmall">24</sys:Double>
  <sys:Double x:Key="LineHeightHeadlineSmall">32</sys:Double>
  <sys:Double x:Key="FontSizeHeadlineMedium">28</sys:Double>
  <sys:Double x:Key="LineHeightHeadlineMedium">36</sys:Double>

  <sys:Double x:Key="ControlHeight">40</sys:Double>
  <sys:Double x:Key="TitleBarHeight">40</sys:Double>
  <sys:Double x:Key="CaptionButtonHeight">32</sys:Double>
  <sys:Double x:Key="IconSize">18</sys:Double>
  <sys:Double x:Key="IconSizeLarge">24</sys:Double>
  <sys:Double x:Key="FabHeight">56</sys:Double>
  <sys:Double x:Key="ListItemHeight">72</sys:Double>
  <sys:Double x:Key="AvatarSize">40</sys:Double>
  <CornerRadius x:Key="ShapeExtraSmall">4</CornerRadius>
  <CornerRadius x:Key="ShapeExtraSmallTop">4,4,0,0</CornerRadius>
  <CornerRadius x:Key="ShapeSmall">8</CornerRadius>
  <CornerRadius x:Key="ShapeMedium">12</CornerRadius>
  <CornerRadius x:Key="ShapeLarge">16</CornerRadius>
  <CornerRadius x:Key="ShapeExtraLarge">28</CornerRadius>
  <CornerRadius x:Key="ShapeFull">20</CornerRadius>

  <Thickness x:Key="ButtonPadding">16,0,24,0</Thickness>
  <Thickness x:Key="TextButtonPadding">12,0</Thickness>
  <Thickness x:Key="FabPadding">16,0,20,0</Thickness>
  <Thickness x:Key="ListItemPadding">16,0,8,0</Thickness>
  <Thickness x:Key="FieldPadding">16,8</Thickness>
  <Thickness x:Key="FieldFocusedPadding">16,8,16,6</Thickness>
  <Thickness x:Key="BannerPadding">16,14</Thickness>
  <Thickness x:Key="TagPadding">12,2</Thickness>
  <Thickness x:Key="TooltipPadding">8,4</Thickness>
  <Thickness x:Key="DialogPadding">24</Thickness>
  <Thickness x:Key="LayoutPadding">24,8,24,24</Thickness>
  <Thickness x:Key="ListSurfacePadding">8</Thickness>
  <Thickness x:Key="PaperPadding">40,32</Thickness>
  <Thickness x:Key="PageBarSpacing">0,0,0,8</Thickness>
  <Thickness x:Key="BannerSpacing">0,0,0,16</Thickness>
  <Thickness x:Key="FormItemGap">0,24,0,0</Thickness>
  <Thickness x:Key="IconGap">0,0,8,0</Thickness>
  <Thickness x:Key="ItemGap">8,0,0,0</Thickness>
</ResourceDictionary>
