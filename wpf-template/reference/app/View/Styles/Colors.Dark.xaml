<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!--  Material Design 3 のダーク配色。Colors.Light.xaml と同じソースカラー・同じキーで、値だけが異なる。  -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="#A9C7FF" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#003063" />
  <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#1E4580" />
  <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#D6E3FF" />
  <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#3E4759" />
  <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#DAE2F9" />
  <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#5D4200" />
  <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="#FFDDB3" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FFB4AB" />
  <SolidColorBrush x:Key="ErrorContainerBrush" Color="#93000A" />
  <SolidColorBrush x:Key="OnErrorContainerBrush" Color="#FFDAD6" />

  <SolidColorBrush x:Key="SurfaceBrush" Color="#111318" />
  <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#0C0E13" />
  <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#1D2024" />
  <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#282A2F" />
  <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#33353A" />
  <SolidColorBrush x:Key="OnSurfaceBrush" Color="#E2E2E9" />
  <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#C4C6D0" />
  <SolidColorBrush x:Key="OutlineBrush" Color="#8E9099" />
  <SolidColorBrush x:Key="OutlineVariantBrush" Color="#44474F" />
  <SolidColorBrush x:Key="InverseSurfaceBrush" Color="#E2E2E9" />
  <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="#2E3036" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
  <SolidColorBrush x:Key="DisabledContainerBrush" Color="#1FE2E2E9" />
  <SolidColorBrush x:Key="DisabledContentBrush" Color="#61E2E2E9" />

  <!--  タイトルバーのテーマ切り替え。切り替え先のテーマを太陽の形と文言で示す。  -->
  <sys:String x:Key="ThemeToggleText">ライトテーマに切り替え</sys:String>
  <GeometryGroup x:Key="ThemeToggleIcon">
    <EllipseGeometry Center="512,512"
                     RadiusX="176"
                     RadiusY="176" />
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="480,96,64,144" />
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="480,784,64,144" />
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="96,480,144,64" />
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="784,480,144,64" />
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="480,96,64,144">
      <RectangleGeometry.Transform>
        <RotateTransform Angle="45" CenterX="512" CenterY="512" />
      </RectangleGeometry.Transform>
    </RectangleGeometry>
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="480,96,64,144">
      <RectangleGeometry.Transform>
        <RotateTransform Angle="135" CenterX="512" CenterY="512" />
      </RectangleGeometry.Transform>
    </RectangleGeometry>
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="480,96,64,144">
      <RectangleGeometry.Transform>
        <RotateTransform Angle="225" CenterX="512" CenterY="512" />
      </RectangleGeometry.Transform>
    </RectangleGeometry>
    <RectangleGeometry RadiusX="32"
                       RadiusY="32"
                       Rect="480,96,64,144">
      <RectangleGeometry.Transform>
        <RotateTransform Angle="315" CenterX="512" CenterY="512" />
      </RectangleGeometry.Transform>
    </RectangleGeometry>
  </GeometryGroup>
</ResourceDictionary>
