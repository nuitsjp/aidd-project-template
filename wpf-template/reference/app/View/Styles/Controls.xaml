<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:v="clr-namespace:WpfNotesSample.View">
  <!--  アイコンの形状を viewBox "64 64 896 896" のまま、要素の大きさへ拡大縮小して前景色で塗る。  -->
  <Style x:Key="IconStyle" TargetType="Control">
    <Setter Property="Width" Value="{StaticResource IconSize}" />
    <Setter Property="Height" Value="{StaticResource IconSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Viewbox>
            <Canvas Width="1024"
                    Height="1024"
                    Margin="-64">
              <Path Data="{TemplateBinding v:Icon.Data}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  フォーカス表示。部品の外側 3 の位置に、primary の 2 の線を描く。  -->
  <Style x:Key="FocusOutlineStyle" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border Margin="-3"
                  BorderBrush="{DynamicResource PrimaryBrush}"
                  BorderThickness="2"
                  CornerRadius="22" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Button の outlined。Style.Resources の ButtonCornerRadius が角丸、ButtonIconSize がアイコンの大きさを決める。
    状態は内容色の層の不透明度で示す（hover 8%、pressed 10%）。アイコンの左に 16、文字の右に 24 の余白を置く。
  -->
  <Style x:Key="BaseButtonStyle" TargetType="Button">
    <Style.Resources>
      <CornerRadius x:Key="ButtonCornerRadius">20</CornerRadius>
      <sys:Double x:Key="ButtonIconSize">18</sys:Double>
    </Style.Resources>
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="v:Icon.Data" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutlineStyle}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource ButtonCornerRadius}">
            <Grid>
              <Border x:Name="StateLayer"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{DynamicResource ButtonCornerRadius}"
                      Opacity="0" />
              <StackPanel Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Orientation="Horizontal">
                <Control x:Name="Glyph"
                         Width="{DynamicResource ButtonIconSize}"
                         Height="{DynamicResource ButtonIconSize}"
                         Margin="{StaticResource IconGap}"
                         v:Icon.Data="{TemplateBinding v:Icon.Data}"
                         Foreground="{TemplateBinding Foreground}"
                         Style="{StaticResource IconStyle}" />
                <ContentPresenter x:Name="Label"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="v:Icon.Data" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Glyph" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="StateLayer" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="StateLayer" Property="Opacity" Value="0.1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="StateLayer" Property="Opacity" Value="0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="BorderBrush" Value="{DynamicResource DisabledContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DisabledContentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button" />

  <!--  入力欄の本体。枠と背景は FilledFieldStyle の容器が描く。  -->
  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource PrimaryBrush}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
    <Setter Property="MinHeight" Value="{StaticResource LineHeightBodyLarge}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource DisabledContentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight}" />
  </Style>

  <!--  入力欄のラベル（body small）。  -->
  <Style TargetType="Label">
    <Setter Property="Padding" Value="0,0,0,2" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceVariantBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Label">
          <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Plain tooltip  -->
  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource InverseSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InverseOnSurfaceBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
    <Setter Property="Padding" Value="{StaticResource TooltipPadding}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border MinHeight="24"
                  MaxWidth="250"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource ShapeExtraSmall}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  List。項目は高さ 72・角丸 16 で、選択中は secondary container の色面で示す。  -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        Focusable="False">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Height" Value="{StaticResource ListItemHeight}" />
    <Setter Property="Padding" Value="{StaticResource ListItemPadding}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource ShapeLarge}" />
            <Border x:Name="StateLayer"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="{StaticResource ShapeLarge}"
                    Opacity="0" />
            <Border x:Name="FocusRing"
                    BorderBrush="{DynamicResource PrimaryBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource ShapeLarge}"
                    Visibility="Hidden" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="StateLayer" Property="Opacity" Value="0.08" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource SecondaryContainerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{DynamicResource DisabledContentBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!--  スクロールバー。幅 8 の角丸のつまみだけを描き、両端の矢印と溝は置かない。  -->
  <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource OutlineVariantBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Margin="2"
                  Background="{TemplateBinding Background}"
                  CornerRadius="2" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource OutlineBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True">
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumbStyle}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track">
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumbStyle}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
