<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:v="clr-namespace:WpfNotesSample.View">
  <!--  Ant Design Icons の形状を viewBox "64 64 896 896" のまま、要素の大きさへ拡大縮小して前景色で塗る。  -->
  <Style x:Key="IconStyle" TargetType="Control">
    <Setter Property="Width" Value="{StaticResource FontSize}" />
    <Setter Property="Height" Value="{StaticResource FontSize}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Viewbox>
            <Canvas Width="1024"
                    Height="1024"
                    Margin="-64">
              <Path Data="{TemplateBinding v:Icon.Data}" Fill="{TemplateBinding Foreground}" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  :focus-visible の outline（3px、colorPrimaryBorder、offset 1px）。  -->
  <Style x:Key="FocusOutlineStyle" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Control">
          <Border Margin="-4"
                  BorderBrush="{StaticResource ColorPrimaryBorderBrush}"
                  BorderThickness="3"
                  CornerRadius="10" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    Button の default。Style.Resources の ButtonShadowBrush が 0 2px 0 の影の色、ButtonCornerRadius が角丸を決める。
    アイコンの大きさは Ant Design と同じく文字サイズに合わせる。
  -->
  <Style x:Key="BaseButtonStyle" TargetType="Button">
    <Style.Resources>
      <SolidColorBrush x:Key="ButtonShadowBrush" Color="#05000000" />
      <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
    </Style.Resources>
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineWidth}" />
    <Setter Property="v:Icon.Data" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutlineStyle}" />
    <Setter Property="ToolTipService.InitialShowDelay" Value="100" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Shadow"
                    Margin="0,2,0,-2"
                    Background="{DynamicResource ButtonShadowBrush}"
                    CornerRadius="{DynamicResource ButtonCornerRadius}" />
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ButtonCornerRadius}">
              <StackPanel Margin="{TemplateBinding Padding}"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Orientation="Horizontal">
                <Control x:Name="Glyph"
                         Width="{TemplateBinding FontSize}"
                         Height="{TemplateBinding FontSize}"
                         Margin="{StaticResource IconGap}"
                         v:Icon.Data="{TemplateBinding v:Icon.Data}"
                         Foreground="{TemplateBinding Foreground}"
                         Style="{StaticResource IconStyle}" />
                <ContentPresenter x:Name="Label"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True" />
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="v:Icon.Data" Value="{x:Null}">
              <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Glyph" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimaryHoverBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorPrimaryHoverBrush}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource ColorPrimaryActiveBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorPrimaryActiveBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{StaticResource ColorBgContainerDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button" />

  <!--  Input と TextArea。focus 時は枠の外側に 2px の activeShadow を描く。  -->
  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="{StaticResource InputPadding}" />
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource ColorBorderBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource LineWidth}" />
    <Setter Property="CaretBrush" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource ColorPrimaryBrush}" />
    <Setter Property="SelectionOpacity" Value="0.3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <Border x:Name="FocusRing"
                    Margin="-2"
                    BorderBrush="{StaticResource ControlOutlineBrush}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource BorderRadiusLG}"
                    Visibility="Hidden" />
            <Border x:Name="InputBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource BorderRadius}">
              <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource ColorPrimaryHoverBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource ColorPrimaryBrush}" />
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="InputBorder" Property="Background" Value="{StaticResource ColorBgContainerDisabledBrush}" />
              <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource ColorBorderBrush}" />
              <Setter TargetName="FocusRing" Property="Visibility" Value="Hidden" />
              <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="{StaticResource LineHeight}" />
  </Style>

  <!--  Form（vertical）のラベル。  -->
  <Style TargetType="Label">
    <Setter Property="Padding" Value="{StaticResource FormLabelPadding}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Label">
          <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{StaticResource ColorBgSpotlightBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextLightSolidBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize}" />
    <Setter Property="Padding" Value="{StaticResource TooltipPadding}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border MinWidth="28"
                  MinHeight="{StaticResource ControlHeight}"
                  MaxWidth="250"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource BorderRadius}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--  Table（size small、bordered なし）。ヘッダーは上側の角丸 8 と背景・下線を表全体で描く。  -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ColorBorderSecondaryBrush}" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="RowBackground" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="CanUserResizeRows" Value="False" />
    <Setter Property="CanUserResizeColumns" Value="False" />
    <Setter Property="CanUserSortColumns" Value="False" />
    <Setter Property="CanUserReorderColumns" Value="False" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGrid">
          <Border Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
              <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.ColumnSpan="2"
                            Background="{StaticResource TableHeaderBgBrush}"
                            BorderBrush="{StaticResource ColorBorderSecondaryBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="8,8,0,0" />
                    <primitives:DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" />
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                            Grid.Row="1"
                                            CanContentScroll="{TemplateBinding CanContentScroll}" />
                    <ScrollBar x:Name="PART_VerticalScrollBar"
                               Grid.Row="1"
                               Grid.Column="1"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               Orientation="Vertical"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                               Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ScrollBar x:Name="PART_HorizontalScrollBar"
                               Grid.Row="2"
                               Maximum="{TemplateBinding ScrollableWidth}"
                               Orientation="Horizontal"
                               ViewportSize="{TemplateBinding ViewportWidth}"
                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                               Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Grid>
                </ControlTemplate>
              </ScrollViewer.Template>
              <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{StaticResource ColorBgContainerBrush}" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource TableHeaderBgBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource ColorPrimaryBgBrush}" />
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="True" />
          <Condition Property="IsMouseOver" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{StaticResource ColorPrimaryBgHoverBrush}" />
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="Padding" Value="{StaticResource TableCellPaddingSM}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
            <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Foreground" Value="{StaticResource ColorTextDisabledBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!--  列見出し。列の間には高さ 1.6em の区切り線を描き、先頭列と表の右余白には描かない。  -->
  <Style TargetType="primitives:DataGridColumnHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource ColorTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="{StaticResource TableCellPaddingSM}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="primitives:DataGridColumnHeader">
          <Grid Background="{TemplateBinding Background}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
            <Rectangle x:Name="Split"
                       Width="1"
                       Height="22.4"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Fill="{StaticResource ColorBorderSecondaryBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Column.DisplayIndex, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
              <Setter TargetName="Split" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Column, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
              <Setter TargetName="Split" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
