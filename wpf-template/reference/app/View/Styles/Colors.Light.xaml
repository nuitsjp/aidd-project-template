<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!--
    Material Design 3 のライト配色。ソースカラー #0F6CBD から作ったトーナルパレットの役割トークンで、キー名は役割名に合わせる。
    Colors.Dark.xaml と同じキーを持ち、画面からは DynamicResource で参照して実行中に差し替える。
  -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="#2D5DA8" />
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="PrimaryContainerBrush" Color="#D6E3FF" />
  <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="#001B3E" />
  <SolidColorBrush x:Key="SecondaryContainerBrush" Color="#DAE2F9" />
  <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="#131C2B" />
  <SolidColorBrush x:Key="TertiaryContainerBrush" Color="#FFDDB3" />
  <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="#2A1800" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#BA1A1A" />
  <SolidColorBrush x:Key="ErrorContainerBrush" Color="#FFDAD6" />
  <SolidColorBrush x:Key="OnErrorContainerBrush" Color="#410002" />

  <SolidColorBrush x:Key="SurfaceBrush" Color="#F9F9FF" />
  <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceContainerBrush" Color="#EDEDF4" />
  <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="#E7E8EE" />
  <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="#E2E2E9" />
  <SolidColorBrush x:Key="OnSurfaceBrush" Color="#191C20" />
  <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="#44474F" />
  <SolidColorBrush x:Key="OutlineBrush" Color="#74777F" />
  <SolidColorBrush x:Key="OutlineVariantBrush" Color="#C4C6D0" />
  <SolidColorBrush x:Key="InverseSurfaceBrush" Color="#2E3036" />
  <SolidColorBrush x:Key="InverseOnSurfaceBrush" Color="#F0F0F7" />
  <SolidColorBrush x:Key="ScrimBrush" Color="#52000000" />
  <!--  無効状態。容器は on-surface の 12%、内容は 38% の不透明度。  -->
  <SolidColorBrush x:Key="DisabledContainerBrush" Color="#1F191C20" />
  <SolidColorBrush x:Key="DisabledContentBrush" Color="#61191C20" />

  <!--  タイトルバーのテーマ切り替え。切り替え先のテーマを月の形と文言で示す。  -->
  <sys:String x:Key="ThemeToggleText">ダークテーマに切り替え</sys:String>
  <CombinedGeometry x:Key="ThemeToggleIcon" GeometryCombineMode="Exclude">
    <CombinedGeometry.Geometry1>
      <EllipseGeometry Center="512,512"
                       RadiusX="352"
                       RadiusY="352" />
    </CombinedGeometry.Geometry1>
    <CombinedGeometry.Geometry2>
      <EllipseGeometry Center="704,320"
                       RadiusX="288"
                       RadiusY="288" />
    </CombinedGeometry.Geometry2>
  </CombinedGeometry>
</ResourceDictionary>
