<UserControl x:Class="WpfNotesSample.View.NoteDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WpfNotesSample.View">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <Grid IsEnabled="{Binding CanInteract}" Style="{StaticResource PageBarStyle}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton"
                v:Icon.Data="{StaticResource IconArrowLeft}"
                AutomationProperties.Name="一覧へ戻る"
                Command="{Binding BackCommand}"
                Style="{StaticResource IconButtonStyle}"
                ToolTip="一覧へ戻る" />
        <TextBlock x:Name="TitleText"
                   Grid.Column="1"
                   Style="{StaticResource PageTitleTextStyle}"
                   Text="{Binding NoteTitle}" />
        <StackPanel Grid.Column="2" Style="{StaticResource PageActionsStyle}">
          <Button x:Name="DeleteButton"
                  v:Icon.Data="{StaticResource IconDelete}"
                  Command="{Binding DeleteNoteCommand}"
                  Content="削除"
                  Style="{StaticResource ErrorOutlinedButtonStyle}" />
          <Button x:Name="EditButton"
                  Margin="{StaticResource ItemGap}"
                  v:Icon.Data="{StaticResource IconEdit}"
                  Command="{Binding EditNoteCommand}"
                  Content="編集"
                  Style="{StaticResource TonalButtonStyle}" />
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ErrorBannerStyle}">
        <DockPanel>
          <Control Style="{StaticResource ErrorBannerIconStyle}" />
          <TextBlock x:Name="ErrorText"
                     Style="{StaticResource BannerTextStyle}"
                     Text="{Binding ErrorMessage}" />
        </DockPanel>
      </Border>
    </StackPanel>
    <Border Style="{StaticResource PaperStyle}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource MetaChipStyle}">
          <StackPanel Orientation="Horizontal">
            <Control Style="{StaticResource MetaIconStyle}" />
            <TextBlock x:Name="UpdatedText"
                       Style="{StaticResource MetaTextStyle}"
                       Text="{Binding Note.UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}（UTC）'}" />
          </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="BodyText"
                     Style="{StaticResource ReadingTextStyle}"
                     Text="{Binding Body}" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
