<UserControl x:Class="WpfNotesSample.View.NoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="メモ一覧" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
      <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanInteract}">
        <Button x:Name="NewNoteButton" Content="新規作成" Command="{Binding NewNoteCommand}" />
        <Button x:Name="EditNoteButton" Content="編集" Command="{Binding EditNoteCommand}" />
        <Button x:Name="DeleteNoteButton" Content="削除" Command="{Binding DeleteNoteCommand}" />
        <Button x:Name="RefreshButton" Content="再読み込み" Command="{Binding RefreshCommand}" />
      </StackPanel>
      <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" Foreground="#B42318" Margin="0,12,0,0" />
      <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Margin="0,8,0,12" />
    </StackPanel>
    <DataGrid x:Name="NotesGrid" ItemsSource="{Binding Notes}" SelectedItem="{Binding SelectedNote}" AutoGenerateColumns="False"
              IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" IsEnabled="{Binding CanInteract}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="タイトル" Binding="{Binding Title}" Width="2*" />
        <DataGridTextColumn Header="本文" Binding="{Binding Body}" Width="3*" />
        <DataGridTextColumn Header="更新日時（UTC）" Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
