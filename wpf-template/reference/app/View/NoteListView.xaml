<UserControl x:Class="WpfNotesSample.View.NoteListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WpfNotesSample.View">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <Grid Style="{StaticResource PageBarStyle}">
        <StackPanel IsEnabled="{Binding CanInteract}" Style="{StaticResource PageActionsStyle}">
          <Button x:Name="NewNoteButton"
                  v:Icon.Data="{StaticResource IconPlus}"
                  Command="{Binding NewNoteCommand}"
                  Content="追加"
                  Style="{StaticResource PrimaryButtonStyle}" />
          <Button x:Name="RefreshButton"
                  Margin="{StaticResource ItemGap}"
                  v:Icon.Data="{StaticResource IconReload}"
                  Command="{Binding RefreshCommand}"
                  Content="再読み込み" />
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ErrorAlertStyle}">
        <DockPanel>
          <Control Style="{StaticResource ErrorAlertIconStyle}" />
          <TextBlock x:Name="ErrorText"
                     Style="{StaticResource AlertTextStyle}"
                     Text="{Binding ErrorMessage}" />
        </DockPanel>
      </Border>
    </StackPanel>
    <Border Style="{StaticResource TableCardStyle}">
      <Grid>
        <DataGrid x:Name="NotesGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsEnabled="{Binding CanInteract}"
                  IsReadOnly="True"
                  ItemsSource="{Binding Notes}"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
          <DataGrid.Columns>
            <DataGridTextColumn Width="*"
                                Binding="{Binding Title}"
                                Header="タイトル" />
            <DataGridTextColumn Width="160"
                                Binding="{Binding UpdatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                Header="更新日時（UTC）" />
            <DataGridTemplateColumn Width="64">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                          CommandParameter="{Binding}"
                          Content="詳細"
                          Style="{StaticResource RowActionButtonStyle}" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <StackPanel Style="{StaticResource EmptyStateStyle}">
          <Control Style="{StaticResource EmptyImageStyle}" />
          <TextBlock Style="{StaticResource EmptyStateTextStyle}" Text="まだノートがありません。&#10;「追加」から最初のノートを作成できます。" />
        </StackPanel>
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
