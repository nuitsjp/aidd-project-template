<UserControl x:Class="WpfNotesSample.View.NoteEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WpfNotesSample.View">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <Grid IsEnabled="{Binding CanInteract}" Style="{StaticResource PageBarStyle}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton"
                v:Icon.Data="{StaticResource IconArrowLeft}"
                AutomationProperties.Name="一覧へ戻る"
                Command="{Binding BackCommand}"
                Style="{StaticResource IconButtonStyle}"
                ToolTip="一覧へ戻る" />
        <StackPanel Grid.Column="2" Style="{StaticResource PageActionsStyle}">
          <Button x:Name="DiscardButton"
                  v:Icon.Data="{StaticResource IconUndo}"
                  Command="{Binding DiscardCommand}"
                  Content="変更を破棄"
                  Style="{StaticResource TextButtonStyle}" />
          <Button x:Name="SaveButton"
                  Margin="{StaticResource ItemGap}"
                  v:Icon.Data="{StaticResource IconSave}"
                  Command="{Binding SaveCommand}"
                  Content="保存"
                  Style="{StaticResource FilledButtonStyle}" />
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ErrorBannerStyle}">
        <DockPanel>
          <Control Style="{StaticResource ErrorBannerIconStyle}" />
          <TextBlock x:Name="ErrorText"
                     Style="{StaticResource BannerTextStyle}"
                     Text="{Binding ErrorMessage}" />
        </DockPanel>
      </Border>
      <Border Style="{StaticResource SuccessBannerStyle}">
        <DockPanel>
          <Control Style="{StaticResource SuccessBannerIconStyle}" />
          <TextBlock x:Name="StatusText"
                     Style="{StaticResource BannerTextStyle}"
                     Text="{Binding StatusMessage}" />
        </DockPanel>
      </Border>
    </StackPanel>
    <Grid IsEnabled="{Binding CanInteract}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource FilledFieldStyle}">
        <StackPanel>
          <Label Content="タイトル"
                 Style="{StaticResource RequiredFieldLabelStyle}"
                 Target="{Binding ElementName=TitleInput}" />
          <TextBox x:Name="TitleInput" Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="1"
                 Style="{StaticResource FieldHelpTextStyle}"
                 Text="1～100 文字" />
      <Border Grid.Row="2"
              Margin="{StaticResource FormItemGap}"
              Style="{StaticResource FilledFieldStyle}">
        <DockPanel>
          <Label Content="本文"
                 DockPanel.Dock="Top"
                 Style="{StaticResource FieldLabelStyle}"
                 Target="{Binding ElementName=BodyInput}" />
          <TextBox x:Name="BodyInput"
                   AcceptsReturn="True"
                   Style="{StaticResource TextAreaStyle}"
                   Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
      <TextBlock Grid.Row="3"
                 Style="{StaticResource FieldHelpTextStyle}"
                 Text="10,000 文字以内" />
    </Grid>
  </DockPanel>
</UserControl>
