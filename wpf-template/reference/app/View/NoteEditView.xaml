<UserControl x:Class="WpfNotesSample.View.NoteEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WpfNotesSample.View">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <Grid IsEnabled="{Binding CanInteract}" Style="{StaticResource PageBarStyle}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton"
                v:Icon.Data="{StaticResource IconArrowLeft}"
                AutomationProperties.Name="一覧へ戻る"
                Command="{Binding BackCommand}"
                Style="{StaticResource BackButtonStyle}"
                ToolTip="一覧へ戻る" />
        <StackPanel Grid.Column="2" Style="{StaticResource PageActionsStyle}">
          <Button x:Name="DiscardButton"
                  v:Icon.Data="{StaticResource IconUndo}"
                  Command="{Binding DiscardCommand}"
                  Content="変更を破棄" />
          <Button x:Name="SaveButton"
                  Margin="{StaticResource ItemGap}"
                  v:Icon.Data="{StaticResource IconSave}"
                  Command="{Binding SaveCommand}"
                  Content="保存"
                  Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource ErrorAlertStyle}">
        <DockPanel>
          <Control Style="{StaticResource ErrorAlertIconStyle}" />
          <TextBlock x:Name="ErrorText"
                     Style="{StaticResource AlertTextStyle}"
                     Text="{Binding ErrorMessage}" />
        </DockPanel>
      </Border>
      <Border Style="{StaticResource SuccessAlertStyle}">
        <DockPanel>
          <Control Style="{StaticResource SuccessAlertIconStyle}" />
          <TextBlock x:Name="StatusText"
                     Style="{StaticResource AlertTextStyle}"
                     Text="{Binding StatusMessage}" />
        </DockPanel>
      </Border>
    </StackPanel>
    <Border Style="{StaticResource CardStyle}">
      <Grid IsEnabled="{Binding CanInteract}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Style="{StaticResource FormItemStyle}">
          <Label Content="タイトル（1～100文字）"
                 Style="{StaticResource RequiredLabelStyle}"
                 Target="{Binding ElementName=TitleInput}" />
          <TextBox x:Name="TitleInput" Text="{Binding NoteTitle, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <Label Grid.Row="1"
               Content="本文（10,000文字以内）"
               Target="{Binding ElementName=BodyInput}" />
        <TextBox x:Name="BodyInput"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 Style="{StaticResource TextAreaStyle}"
                 Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" />
      </Grid>
    </Border>
  </DockPanel>
</UserControl>
